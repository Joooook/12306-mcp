{
  "name": "12306-mcp",
  "version": "0.3.10",
  "main": "build/index.js",
  "scripts": {
    "prebuild": "run-script-os",
    "prebuild:win32": "del /q /s build\\* >nul 2>&1",
    "prebuild:default": "rm -rf build/*",
    "build": "tsc",
    "postbuild": "run-script-os",
    "postbuild:darwin:linux": "chmod +x build/index.js",
    "postbuild:default": "",
    "prepare": "npm run build",
    "test": "tsc && node ./build/index.js",
    "test:http": "tsc && node ./build/index.js --port 8080",
    "debug": "tsc && npx --yes --package @modelcontextprotocol/inspector@2.0.0 mcp-inspector node ./build/index.js"
  },
  "keywords": [
    "mcp",
    "12306",
    "mcp-server"
  ],
  "author": "joooook",
  "license": "MIT",
  "description": "This is a 12306 ticket search server based on the Model Context Protocol (MCP). ",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "axios": "^1.18.1",
    "commander": "^14.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "run-script-os": "^1.1.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "12306-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  }
}
